// Renovate, self-hosted in the d42-infra cluster (docs/runbooks/renovate.md
// there). It covers Cargo dependencies, the Dockerfile's base images and the
// GitHub Actions in .github/workflows. Minor and patch updates automerge once
// CI passes, grouped into one PR a day; majors and digest bumps are separate
// PRs to review.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':dependencyDashboard'],
  timezone: 'Europe/Oslo',
  gitAuthor: 'Renovate <renovate@dot42.no>',
  // Renovate merges the PR itself after CI is green, not GitHub's auto-merge
  // (there's no branch protection to make that wait for CI).
  automergeType: 'pr',
  platformAutomerge: false,
  customManagers: [
    {
      // The Rust version is pinned twice: the Dockerfile (rust:1.99-alpine)
      // and rust-toolchain.toml. This makes Renovate see the second one too,
      // as the same rust image, so the group below bumps both in one PR.
      customType: 'regex',
      description: 'Rust toolchain channel',
      managerFilePatterns: ['/^rust-toolchain\\.toml$/'],
      matchStrings: ['channel = "(?<currentValue>\\d+\\.\\d+)"'],
      depNameTemplate: 'rust',
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      description: 'Minor and patch updates: one grouped PR a day, automerged once CI passes',
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'all minor and patch dependencies',
      groupSlug: 'all-minor-patch',
      schedule: ['before 6am'],
      automerge: true,
    },
    {
      description: 'Rust toolchain: the Dockerfile and rust-toolchain.toml in one PR',
      matchPackageNames: ['rust'],
      groupName: 'rust',
    },
  ],
}
